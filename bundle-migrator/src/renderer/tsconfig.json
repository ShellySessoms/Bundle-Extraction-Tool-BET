{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "..",
    "outDir": "../../out/renderer",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "../shared/**/*.ts"]
}
